# --- LLM: výchozí je Gemini (Google AI Studio, free tier) ------------------
# Klíč zdarma na https://aistudio.google.com/apikey
GEMINI_API_KEY=CHANGE_ME

# Model se zapisuje s prefixem poskytovatele:
#   google/...      Gemini API
#   openrouter/...  OpenRouter
#   bez prefixu     endpoint z LLM_BASE_URL (viz níž)
MODEL=google/gemini-3.7-flash
# menší varianty, když free tier na 3.7 nestačí:
# MODEL=google/gemini-3.5-flash-lite
# MODEL=google/gemini-2.5-flash
#
# Modely, na které tvůj klíč dosáhne:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GEMINI_API_KEY" | grep '"name"'

# --- Náhradní modely ------------------------------------------------------
# Můžou být od jiného poskytovatele než ten hlavní. Naskočí, když hlavní model
# selže (kvóta, výpadek). Model bez klíče se automaticky přeskočí.
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME
# FALLBACK_MODELS=openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/z-ai/glm-5.2:free
#
# Free modely na OpenRouteru musí umět tool calling, jinak agent nezavolá
# jediný nástroj. Ověřený seznam je v README.

# --- Jiný provider --------------------------------------------------------
# Model bez známého prefixu se pošle na LLM_BASE_URL s klíčem LLM_API_KEY.
# Stačí OpenAI-kompatibilní API, v kódu se nemění nic.
#
# OpenAI:
# MODEL=gpt-4o-mini
# LLM_API_KEY=sk-...
#
# LiteLLM proxy z podkladů kurzu (SOURCE/5_custom_framework/0_litellm):
# MODEL=gpt-4o-mini
# LLM_BASE_URL=http://localhost:4000
# LLM_API_KEY=sk-1234
#
# Lokální Ollama (model musí umět tool calling, např. qwen3 nebo llama3.1):
# MODEL=qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1

# --- MCP server s nástroji ------------------------------------------------
# stdio = agent si server spustí sám jako podproces (výchozí, nic dalšího
# není potřeba). http = připojí se na už běžící server.
MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http
# MCP_URL=http://127.0.0.1:8010/mcp

# --- Cesty (volitelné) ----------------------------------------------------
# KNIHOVNA_DB=data/knihovna.db
# REPORT_DIR=out
