# --- LLM: výchozí je free tier OpenRouteru --------------------------------
# klíč zdarma na https://openrouter.ai/keys (stejný, jaký používají úkoly 1 a 2)
OPENROUTER_API_KEY=sk-or-v1-CHANGE_ME

# Model musí umět tool calling, jinak agent nezavolá žádný nástroj.
# Ověřený seznam free modelů s podporou nástrojů je v README.
MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Náhradní modely pro případ, že hlavní vrátí 429 (čárkou oddělený seznam).
# FALLBACK_MODELS=z-ai/glm-5.2:free,google/gemma-4-31b-it:free

# --- Jiný provider --------------------------------------------------------
# Agent mluví s obyčejným OpenAI-kompatibilním API, takže stačí přepsat adresu,
# klíč a model - v kódu se nemění nic.
#
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# MODEL=gpt-4o-mini
#
# LiteLLM proxy z podkladů kurzu (SOURCE/5_custom_framework/0_litellm):
# LLM_BASE_URL=http://localhost:4000
# LLM_API_KEY=sk-1234
# MODEL=gpt-4o-mini
#
# Lokální Ollama (model musí umět tool calling, např. qwen3 nebo llama3.1):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL=qwen3:8b

# --- MCP server s nástroji ------------------------------------------------
# stdio = agent si server spustí sám jako podproces (výchozí, nic dalšího
# není potřeba). http = připojí se na už běžící server.
MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http
# MCP_URL=http://127.0.0.1:8010/mcp

# --- Cesty (volitelné) ----------------------------------------------------
# KNIHOVNA_DB=data/knihovna.db
# REPORT_DIR=out
