# --- n8n ------------------------------------------------------------------
N8N_URL=https://CHANGE_ME.app.n8n.cloud
# API klíč potřebuje jen scripts/setup_n8n.py (automatický import).
# Free tier n8n Cloudu veřejné API nemá - tam se workflow vkládá ručně
# (viz README) a tenhle řádek zůstane prázdný. scripts/test_agent.py
# si vystačí s N8N_URL.
N8N_API_KEY=
# lokální instance z podkladů kurzu:
# N8N_URL=http://localhost:5678

# --- LLM: OpenRouter free tier -------------------------------------------
# klíč z https://openrouter.ai/keys (stejný, jaký používá hmwrk_1)
OPENROUTER_API_KEY=CHANGE_ME
# volitelné - přepíše model nastavený ve workflow.json
# (musí umět tool calling; ověřené free modely jsou v README)
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- Databáze: Supabase (výchozí) ----------------------------------------
# Supabase -> tlačítko Connect -> Session pooler (NE Direct connection:
# ta je na free tieru jen přes IPv6, kam n8n Cloud ani Docker nedosáhne).
PG_HOST=aws-1-eu-central-1.pooler.supabase.com
PG_PORT=5432
PG_DATABASE=postgres
PG_USER=postgres.CHANGE_ME_PROJECT_REF
PG_PASSWORD=CHANGE_ME
PG_SSL=require
PG_ALLOW_UNAUTHORIZED=true

# --- Databáze: lokální Postgres (alternativa bez Supabase) ---------------
# spusť `docker compose up -d` v této složce a použij místo hodnot výše:
# PG_HOST=host.docker.internal   # pro skripty na hostu: localhost
# PG_PORT=5433
# PG_DATABASE=eshop
# PG_USER=eshop
# PG_PASSWORD=eshop
# PG_SSL=disable
